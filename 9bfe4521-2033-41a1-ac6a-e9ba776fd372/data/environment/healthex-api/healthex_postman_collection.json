{
  "info": {
    "name": "HealthEx API Mock FHIR R4",
    "description": "Mock HealthEx API FHIR R4. Base URL: http://localhost:8137. In docker-compose: http://healthex-api:8137. Get a token from POST /oauth/token first; each operation checks its own scope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8137"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "token (default scopes)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "grant_type=client_credentials&client_id=healthex-connector-app&client_secret=hxcs_b81e4f2a097c6d35"
        }
      }
    },
    {
      "name": "token with every granted scope",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"grant_type\": \"client_credentials\", \"client_id\": \"healthex-connector-app\", \"client_secret\": \"hxcs_b81e4f2a097c6d35\", \"scope\": \"patient/Condition.read patient/MedicationRequest.read patient/Observation.read patient/Immunization.read patient/Encounter.read\"}"
        }
      }
    },
    {
      "name": "tokeninfo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/oauth/tokeninfo",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list conditions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/Condition",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get one condition",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/Condition/cond-71h3afvtt4",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list medications from one clinician",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/MedicationRequest?provider=prac-okonkwo",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list 2026 lab results",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/Observation?date=ge2026-01-01&date=le2026-12-31&_count=50",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get one lab result",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/Observation/obs-29khc92s3e",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list lab results, next page",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/Observation?_count=20&_offset=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list immunizations since 2025",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/Immunization?date=ge2025",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list visits at one clinic",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/Encounter?provider=Halsted%20Orthopedic%20Group",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list visits in May 2025",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fhir/R4/Encounter?date=2025-05",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    }
  ]
}
