{
  "info": {
    "name": "Spotify Web API Mock v1",
    "description": "Mock Spotify Web API v1. Base URL: http://localhost:8108. In docker-compose: http://spotify-api:8108. Get a token from POST /oauth/token first; search accepts any live token, every other operation checks its own scope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8108"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "token (no scope; search still works)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "grant_type=client_credentials&client_id=spotify-connector-app&client_secret=spcs_3d8f52b7e1a94c60"
        }
      }
    },
    {
      "name": "token with library and playback scopes",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"grant_type\": \"client_credentials\", \"client_id\": \"spotify-connector-app\", \"client_secret\": \"spcs_3d8f52b7e1a94c60\", \"scope\": \"user-library-read playlist-read-private playlist-modify-private user-read-playback-state user-modify-playback-state user-read-currently-playing\"}"
        }
      }
    },
    {
      "name": "tokeninfo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/oauth/tokeninfo",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "search music, podcasts and playlists",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/search?q=jazz&type=track,playlist,show&limit=5",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "saved tracks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/me/tracks?limit=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "my playlists",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/me/playlists?limit=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "playlist tracks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/playlists/PQFTlu92qul1qdGDtU7HIY/tracks",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "create a playlist",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/me/playlists",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Winter Concert Shortlist\", \"description\": \"Candidates for December\", \"public\": false}"
        }
      }
    },
    {
      "name": "update playlist details",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/v1/playlists/gKxmiq5eaFUrO1Gx2ODSac",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Weekend Hiking 2026\", \"description\": \"Gorge trail mix\"}"
        }
      }
    },
    {
      "name": "add tracks to a playlist",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/playlists/EZpfgh0vGPrU0MZuaPlQKX/tracks",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"uris\": [\"spotify:track:khZJt6l7ydcnW5AnZXfFqU\", \"spotify:track:lntoiZXDDKRuMaQ8GshQSD\"], \"position\": 0}"
        }
      }
    },
    {
      "name": "playback devices",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/me/player/devices",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "start playback of an album",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/v1/me/player/play?device_id=c79154e6b2c76baec8e644b85d33668b510ab772",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"context_uri\": \"spotify:album:s7IZj12Q8OLwQYtvR267A4\", \"offset\": {\"position\": 1}, \"position_ms\": 0}"
        }
      }
    },
    {
      "name": "currently playing",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/me/player/currently-playing",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "transfer playback",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/v1/me/player",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"device_ids\": [\"93dac0217db3354d10efac25890de794ba070e81\"], \"play\": true}"
        }
      }
    }
  ]
}
