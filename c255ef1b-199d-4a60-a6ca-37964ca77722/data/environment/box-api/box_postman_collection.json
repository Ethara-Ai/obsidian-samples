{
  "info": {
    "name": "Box API Mock 2.0",
    "description": "Mock Box API 2.0. Base URL: http://localhost:8124. In docker-compose: http://box-api:8124. Get a token from POST /oauth/token first; each operation checks its own scope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8124"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "token (default scopes)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "grant_type=client_credentials&client_id=box-connector-app&client_secret=boxcs_4d81a07e2c9f3b65"
        }
      }
    },
    {
      "name": "token with every granted scope",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"grant_type\": \"client_credentials\", \"client_id\": \"box-connector-app\", \"client_secret\": \"boxcs_4d81a07e2c9f3b65\", \"scope\": \"root_readonly root_readwrite\"}"
        }
      }
    },
    {
      "name": "tokeninfo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/oauth/tokeninfo",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list the root folder",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/2.0/folders/0/items",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list a project folder newest first",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/2.0/folders/254781930535/items?fields=name,modified_at,size&sort=date&direction=DESC&limit=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get a file",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/2.0/files/1310442871099",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get a file's name and shared link",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/2.0/files/1310442871704?fields=name,shared_link,extension",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "search by name",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/2.0/search?query=change%20order&type=file&file_extensions=pdf&limit=10",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "search one project",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/2.0/search?query=punch&ancestor_folder_ids=254781930535&content_types=name",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "create a folder",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/2.0/folders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Site Visit 2026-10-08\", \"parent\": {\"id\": \"254781930535\"}}"
        }
      }
    },
    {
      "name": "upload a small file (multipart)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/2.0/files/content",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "attributes",
              "type": "text",
              "value": "{\"name\": \"site-visit-agenda.txt\", \"parent\": {\"id\": \"254781930960\"}}"
            },
            {
              "key": "file",
              "type": "file",
              "src": "site-visit-agenda.txt"
            }
          ]
        }
      }
    },
    {
      "name": "upload a small file (JSON form)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/2.0/files/content",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"attributes\": {\"name\": \"punch-walk-notes.txt\", \"parent\": {\"id\": \"254781930960\"}}, \"content\": \"Lobby punch walk, October 8: confirm pendant mounting heights.\\n\"}"
        }
      }
    },
    {
      "name": "create a shared link",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/2.0/files/1310442871704?fields=shared_link",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"shared_link\": {\"access\": \"company\", \"permissions\": {\"can_download\": true}}}"
        }
      }
    }
  ]
}
