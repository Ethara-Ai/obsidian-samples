{
  "info": {
    "name": "Outlook Calendar API Mock v1.0",
    "description": "Mock Microsoft Graph v1.0 calendar API (Outlook Calendar). Base URL: http://localhost:8120. In docker-compose: http://outlook-calendar-api:8120. Get a token from POST /oauth/token first; each operation checks its own scope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8120"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "token (default scopes)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "grant_type=client_credentials&client_id=ocal-connector-app&client_secret=ocal_2f851464f2d5a74f"
        }
      }
    },
    {
      "name": "token with every granted scope",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"grant_type\": \"client_credentials\", \"client_id\": \"ocal-connector-app\", \"client_secret\": \"ocal_2f851464f2d5a74f\", \"scope\": \"Calendars.Read Calendars.ReadWrite\"}"
        }
      }
    },
    {
      "name": "tokeninfo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/oauth/tokeninfo",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list calendars",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1.0/me/calendars",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "calendar view of the week of October 5 (Pacific time)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1.0/me/calendarView?startDateTime=2026-10-05T00:00:00-07:00&endDateTime=2026-10-10T00:00:00-07:00&$top=50",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Prefer",
            "value": "outlook.timezone=\"Pacific Standard Time\""
          }
        ]
      }
    },
    {
      "name": "calendar view of the Platform Team calendar for October",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1.0/me/calendars/AAMkAGcal0000002/calendarView?startDateTime=2026-10-01T00:00:00Z&endDateTime=2026-11-01T00:00:00Z",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list customer meetings, latest first",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1.0/me/events?$filter=categories/any(c:c%20eq%20'Customer')&$orderby=start/dateTime%20desc&$select=subject,start,end&$top=5",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list the Platform Team release dates",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1.0/me/calendars/AAMkAGcal0000002/events?$filter=startswith(subject,'Release')&$select=subject,start",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get an event",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1.0/me/events/AAMkAGevt0000032",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get one occurrence of the standup (Pacific time)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1.0/me/events/AAMkAGevt0000013_20261006",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Prefer",
            "value": "outlook.timezone=\"Pacific Standard Time\""
          }
        ]
      }
    },
    {
      "name": "create an event",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1.0/me/events",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"subject\": \"Event bus follow-up\", \"body\": {\"contentType\": \"HTML\", \"content\": \"<p>Partition key decision</p>\"}, \"start\": {\"dateTime\": \"2026-10-08T13:00:00\", \"timeZone\": \"Pacific Standard Time\"}, \"end\": {\"dateTime\": \"2026-10-08T13:30:00\", \"timeZone\": \"Pacific Standard Time\"}, \"attendees\": [{\"emailAddress\": {\"address\": \"diego.santos@contoso.com\", \"name\": \"Diego Santos\"}, \"type\": \"required\"}], \"isOnlineMeeting\": true}"
        }
      }
    },
    {
      "name": "create a weekly series in the Platform Team calendar",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1.0/me/calendars/AAMkAGcal0000002/events",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"subject\": \"Ops sync\", \"start\": {\"dateTime\": \"2026-10-13T09:00:00\", \"timeZone\": \"Pacific Standard Time\"}, \"end\": {\"dateTime\": \"2026-10-13T09:30:00\", \"timeZone\": \"Pacific Standard Time\"}, \"recurrence\": {\"pattern\": {\"type\": \"weekly\", \"interval\": 1, \"daysOfWeek\": [\"tuesday\"]}, \"range\": {\"type\": \"numbered\", \"startDate\": \"2026-10-13\", \"numberOfOccurrences\": 3}}}"
        }
      }
    },
    {
      "name": "move an event",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/v1.0/me/events/AAMkAGevt0000032",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"start\": {\"dateTime\": \"2026-10-07T11:00:00\", \"timeZone\": \"Pacific Standard Time\"}, \"end\": {\"dateTime\": \"2026-10-07T11:45:00\", \"timeZone\": \"Pacific Standard Time\"}}"
        }
      }
    },
    {
      "name": "delete an event",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/v1.0/me/events/<event_id>",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "free/busy for three people (Pacific time)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1.0/me/calendar/getSchedule",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Prefer",
            "value": "outlook.timezone=\"Pacific Standard Time\""
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"schedules\": [\"alex.carter@contoso.com\", \"priya.nair@contoso.com\", \"diego.santos@contoso.com\"], \"startTime\": {\"dateTime\": \"2026-10-06T08:00:00\", \"timeZone\": \"Pacific Standard Time\"}, \"endTime\": {\"dateTime\": \"2026-10-06T18:00:00\", \"timeZone\": \"Pacific Standard Time\"}, \"availabilityViewInterval\": 30}"
        }
      }
    }
  ]
}
