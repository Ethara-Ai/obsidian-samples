  "position": 2,
  "type": "bulleted_list_item",
  "payload": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "A sofa keeps at least 18 inches clear at each open end of its wall, for a side table or a way through. Where a sofa meets another piece of furniture, 4 inches between them is enough. Take that piece's size from a tape or its tag, never from an estimate.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
