 {
  "id": "2484e75a-5b83-548c-bfb6-e88c580feffe",
  "account_id": "acct-jessica-wright",
  "parent": {
   "type": "page_id",
   "page_id": "6cd8a48f-ee2f-5ce2-91fb-c244a602317c"
  },
  "position": 5,
  "type": "bulleted_list_item",
  "payload": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Upholstery in a room that children or pets use is held to ACT's high-traffic upholstery guideline for woven fabrics, indoor use. Read the figure on ACT's own guideline pages (contracttextiles.org/performance-guidelines) and hold each fabric's tested result, as its tag gives it, against it. A mill's own \"heavy duty\" or \"family friendly\" wording is not a test result.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Upholstery in a room that children or pets use is held to ACT's high-traffic upholstery guideline for woven fabrics, indoor use. Read the figure on ACT's own guideline pages (contracttextiles.org/performance-guidelines) and hold each fabric's tested result, as its tag gives it, against it. A mill's own \"heavy duty\" or \"family friendly\" wording is not a test result.",
     "href": null
    }
   ],
   "color": "default"
  },
  "archived": false,
  "created_time": "2026-09-14T13:20:00.000Z",
  "created_by": "c91fac35-a236-5331-af3a-4e4cf6364329",
  "last_edited_time": "2026-09-14T13:20:00.000Z",
  "last_edited_by": "c91fac35-a236-5331-af3a-4e4cf6364329"
 },
