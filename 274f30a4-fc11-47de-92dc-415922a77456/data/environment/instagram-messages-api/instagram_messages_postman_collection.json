{
  "info": {
    "name": "Instagram Messaging API Mock v21.0",
    "description": "Mock Instagram messaging in the Graph API v21.0. Base URL: http://localhost:8112. In docker-compose: http://instagram-messages-api:8112. Get a token from POST /oauth/token first; each operation checks its own scope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8112"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "token (default scopes)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "grant_type=client_credentials&client_id=igmsg-connector-app&client_secret=igmcs_9b9c2bf4de05c3f3"
        }
      }
    },
    {
      "name": "token with every granted scope",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"grant_type\": \"client_credentials\", \"client_id\": \"igmsg-connector-app\", \"client_secret\": \"igmcs_9b9c2bf4de05c3f3\", \"scope\": \"instagram_messages.read instagram_messages.send\"}"
        }
      }
    },
    {
      "name": "tokeninfo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/oauth/tokeninfo",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list conversations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v21.0/me/conversations?platform=instagram&limit=10",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "conversation with one user",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v21.0/me/conversations?platform=instagram&user_id=<IGSID>",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "messages in a conversation",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v21.0/<conversation id>/messages?limit=10",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "send a message",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v21.0/me/messages",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"recipient\": {\"id\": \"<IGSID>\"}, \"message\": {\"text\": \"Thanks for reaching out! Your order ships Tuesday.\"}}"
        }
      }
    }
  ]
}
