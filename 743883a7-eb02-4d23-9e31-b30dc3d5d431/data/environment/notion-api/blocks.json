  "type": "bulleted_list_item",
  "payload": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Bedrooms: a room counts as a bedroom only if it has a door and a closet. A plan shows what the builder drew and the photos show what is there now; the photos win. Without both it is a loft or bonus room, whatever it is labelled.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Bedrooms: a room counts as a bedroom only if it has a door and a closet. A plan shows what the builder drew and the photos show what is there now; the photos win. Without both it is a loft or bonus room, whatever it is labelled.",
     "href": null
