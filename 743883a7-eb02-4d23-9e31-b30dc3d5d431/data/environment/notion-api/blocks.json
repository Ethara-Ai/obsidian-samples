 },
 {
  "id": "69003169-df00-52ab-bf90-e9256289c82b",
  "account_id": "acct-brittany-morales",
  "parent": {
   "type": "page_id",
   "page_id": "2be100c7-70c4-5510-812d-7d139cf2b68b"
  },
  "position": 2,
  "type": "bulleted_list_item",
  "payload": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "What the house shows beats what anyone writes about it. When a seller's answer, a caption or a label on a plan disagrees with the photos, the permit card or a product label, the house wins: fix my record, keep the claim out of every piece of marketing, and put the mismatch on the disclosure checklist so the seller can correct it before signing.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "What the house shows beats what anyone writes about it. When a seller's answer, a caption or a label on a plan disagrees with the photos, the permit card or a product label, the house wins: fix my record, keep the claim out of every piece of marketing, and put the mismatch on the disclosure checklist so the seller can correct it before signing.",
     "href": null
    }
   ],
   "color": "default"
  },
  "archived": false,
  "created_time": "2025-09-12T14:00:00.000Z",
  "created_by": "23dd3501-a17f-5d46-add6-3cb93f0cbfee",
  "last_edited_time": "2026-08-30T12:00:00.000Z",
  "last_edited_by": "23dd3501-a17f-5d46-add6-3cb93f0cbfee"
 },
 {
  "id": "d9eb91db-903d-5098-8546-fee3c91c6174",
