{
  "info": {
    "name": "Tessie API Mock v1",
    "description": "Mock Tessie API v1. Base URL: http://localhost:8133. In docker-compose: http://tessie-api:8133. Get a token from POST /oauth/token first; each operation checks its own scope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8133"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "token (default scopes)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "grant_type=client_credentials&client_id=tessie-connector-app&client_secret=tessiecs_9b3f60d2a7e14c85"
        }
      }
    },
    {
      "name": "token with every granted scope",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/oauth/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"grant_type\": \"client_credentials\", \"client_id\": \"tessie-connector-app\", \"client_secret\": \"tessiecs_9b3f60d2a7e14c85\", \"scope\": \"vehicle_device_data vehicle_location vehicle_cmds vehicle_charging_cmds\"}"
        }
      }
    },
    {
      "name": "tokeninfo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/oauth/tokeninfo",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list vehicles",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/vehicles",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list active vehicles only",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/vehicles?only_active=true",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get a vehicle's state",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/7SAYGDEEXRA214633/state",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get battery and charging status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/7SAYGDEEXRA214633/battery",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "get a vehicle's location",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/5YJ3E1EB5MF903217/location",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list September's business drives",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/7SAYGDEEXRA214633/drives?from=1788238800&to=1790830799&tag=Business",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list the latest drives over 20 miles",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/7SAYGDEEXRA214633/drives?minimum_distance=20&limit=5",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "list Jordan's drives in Wren",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/7SAYGDEEXRA214633/drives?driver_profile=Jordan",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "lock",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/5YJ3E1EB5MF903217/command/lock",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "unlock",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/7SAYGDEEXRA214633/command/unlock",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "start climate",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/7SAYGDEEXRA214633/command/start_climate",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "stop climate",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/7SAYGDEEXRA214633/command/stop_climate",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "start charging",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/5YJ3E1EB5MF903217/command/start_charging",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "stop charging",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/5YJ3E1EB5MF903217/command/stop_charging",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    }
  ]
}
